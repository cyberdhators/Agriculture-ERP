// =============================================================================
// Agriculture ERP -- Prisma schema
//
// -----------------------------------------------------------------------------
// PINNED TO PRISMA 6.19.3, DELIBERATELY
// -----------------------------------------------------------------------------
// Exact pins, no carets: "prisma": "6.19.3" and "@prisma/client": "6.19.3".
//
// This is a decision, not neglect. The pooled-plus-direct connection pattern
// below is the path Supabase documents, and this team cannot read code. A
// well-trodden path is worth more to us than being current.
//
// Prisma 7 removed `url` and `directUrl` from this datasource block and moved
// them to a prisma.config.ts plus a driver adapter. That is a real change to
// how the application connects, and it will be made once, deliberately, as its
// own unit with its own attack review -- never as a side effect of scaffolding.
//
// Do not bump either package as part of unrelated work.
//
// -----------------------------------------------------------------------------
// `prisma migrate dev` IS NOT USED ON THIS PROJECT
// -----------------------------------------------------------------------------
// `migrate dev` requires a shadow database to diff against, and it creates that
// database itself. The Supabase `postgres` role cannot create databases, so the
// command times out or fails outright. That failure is expected. It is not a
// bug to chase, and it is not fixed by retrying.
//
// Migrations here are hand-written SQL in timestamped folders under
// prisma/migrations, applied with `prisma migrate deploy` (pnpm db:migrate).
//
// -----------------------------------------------------------------------------
// PRISMA BYPASSES ROW-LEVEL SECURITY, BY DESIGN -- DO NOT "FIX" THIS
// -----------------------------------------------------------------------------
// Prisma connects as the database owner and therefore bypasses RLS entirely.
// That is correct and intended.
//
// RLS is our backstop against the anon and authenticated Supabase keys, which
// reach the database directly from clients. It is NOT our defence against our
// own server. Server-side, authorisation is enforced by requireRole in the
// Next.js API routes, which checks session and role before any query runs.
//
// So: every table enables RLS with no policies (deny-by-default), and Prisma
// bypasses it as owner. Both are deliberate. A future session that "fixes" this
// by connecting Prisma as a restricted role will break every API route and gain
// nothing.
//
// Prisma cannot author RLS policies. No Prisma version has schema syntax for
// ENABLE ROW LEVEL SECURITY or CREATE POLICY. Policies are hand-written SQL in
// migrations, which is why that rule is written into the migration files.
//
// -----------------------------------------------------------------------------
// THE TWO CONNECTION URLS
// -----------------------------------------------------------------------------
//   DATABASE_URL  Pooled, port 6543, pgbouncer=true & connection_limit=1.
//                 Used by the application at runtime.
//
//   DIRECT_URL    Direct, port 5432. Used by MIGRATIONS and introspection,
//                 which cannot run through the pooler.
//
// Both carry ?schema=public. That is how Prisma is restricted to the public
// schema, so it never introspects, migrates or drops the auth, storage,
// realtime or graphql schemas that Supabase manages itself.
//
// Real values live in .env.local only, never in this repository.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Every model added here must come with a migration that creates the table AND
// enables row-level security on it, in the same migration, with no policies.
//
// These models mirror migration 5 by hand. Migrations are hand-written SQL
// applied with `migrate deploy`; `migrate dev` is not used on this project, so
// nothing generates this file and nothing checks it against the database except
// the tests. Keep them in step deliberately.
//
// The `_active` views are not modelled. Prisma has no view support we rely on,
// and every read in B2 goes through raw SQL against the views for exactly that
// reason.

/// Top level of the location hierarchy. Code as primary key, not a uuid:
/// location codes appear in donor exports, where CE means something.
model State {
  id        String  @id
  name      String
  active    Boolean @default(true)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Foreign key to user added in B3, when that table exists.
  deletedBy String?   @map("deleted_by") @db.Uuid

  counties County[]
  payams   Payam[]
  /// P1 (migration 6). Every scoped table carries state_id, so every one relates here.
  directoryEntries DirectoryEntry[]
  users    User[]
  officers Officer[]
  farmers  Farmer[]

  @@map("state")
}

model County {
  id        String  @id
  name      String
  stateId   String  @map("state_id")
  active    Boolean @default(true)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  state  State   @relation(fields: [stateId], references: [id])
  payams Payam[]
  farmers Farmer[]
  farmerNumberCounter FarmerNumberCounter?

  /// Target of the composite key on payam that enforces C-2.3.
  @@unique([id, stateId], map: "county_id_state_id_key")
  @@index([stateId], map: "county_state_id_idx")
  @@map("county")
}

model Payam {
  id        String @id
  name      String
  countyId  String @map("county_id")
  /// Denormalised, per data-model-extension 1.4, so a scope check is not a join.
  stateId   String @map("state_id")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  /// C-2.3 lives here: the composite key means a payam cannot disagree with
  /// its county about which state it is in.
  county County @relation(fields: [countyId, stateId], references: [id, stateId], map: "payam_county_state_consistent_fkey")
  state  State  @relation(fields: [stateId], references: [id], map: "payam_state_id_fkey")
  directoryEntries DirectoryEntry[]

  officers Officer[]
  farmers  Farmer[]

  /// Target of the composite key on officer.
  @@unique([id, stateId], map: "payam_id_state_id_key")
  /// Target of farmer's second composite key (C-5.5): county must match. B5, migration 10.
  @@unique([id, countyId], map: "payam_id_county_id_key")
  @@index([countyId], map: "payam_county_id_idx")
  /// Target of the composite key on every table below payam that carries a
  /// denormalised state_id. Added by migration 6 (P1); B5 onward reuse it.
  @@index([stateId], map: "payam_state_id_idx")
  @@map("payam")
}

/// One row. Holds the version identifier of the most recently built bundle so
/// a device can ask whether the hierarchy changed without downloading it.
model LocationBundle {
  id          Int      @id @default(1)
  version     String
  builtAt     DateTime @map("built_at") @db.Timestamptz(6)
  stateCount  Int      @map("state_count")
  countyCount Int      @map("county_count")
  payamCount  Int      @map("payam_count")

  @@map("location_bundle")
}

// -----------------------------------------------------------------------------
// P1 -- directories and learning library (migration 6)
// -----------------------------------------------------------------------------
//
// Mirrors migration 6 by hand, like the B2 models above mirror migration 5.
// The `_active` views are not modelled, for the reason given above.
//
// `crop` and `language` are SHARED enum types. crop_declaration (B5/B7) and
// consent (B5) reuse them; they must not be redeclared. See docs/HANDOFF.md.

enum DirectoryEntryType {
  agro_dealer
  input_supplier
  financial_service

  @@map("directory_entry_type")
}

enum FinancialProviderClass {
  bank
  microfinance
  mobile_money
  cooperative_sacco
  other

  @@map("financial_provider_class")
}

enum LearningTopic {
  crop_production
  livestock
  pest_disease
  post_harvest
  marketing
  cooperative
  climate
  other

  @@map("learning_topic")
}

/// SHARED. The five project crops.
enum Crop {
  sorghum
  groundnut
  sesame
  maize
  cowpea

  @@map("crop")
}

/// SHARED. The two interface languages. Prisma identifiers cannot contain a
/// hyphen, so the database value 'ar-juba' is mapped.
enum Language {
  en
  ar_juba @map("ar-juba")

  @@map("language")
}

enum ResourceFormat {
  pdf
  image
  audio
  video

  @@map("resource_format")
}

/// Deliverables (i), (j), (k): one typed table. A named place with a phone
/// number that a farmer can be sent to. Never an account.
model DirectoryEntry {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryType       DirectoryEntryType      @map("entry_type")
  name            String
  description     String?
  services        String[]                @default([])
  contactName     String?                 @map("contact_name")
  /// E.164. The CHECK constraint mirrors parseSouthSudanMobile.
  phone           String
  altPhone        String?                 @map("alt_phone")
  email           String?
  physicalAddress String?                 @map("physical_address")
  /// PostGIS. Read and written with raw SQL; Prisma has no geography type.
  location        Unsupported("geography(Point, 4326)")?
  payamId         String                  @map("payam_id")
  /// Denormalised, per data-model-extension 1.4. The composite key keeps it honest.
  stateId         String                  @map("state_id")
  /// Financial services only; the CHECK constraint enforces both directions.
  providerClass   FinancialProviderClass? @map("provider_class")
  lastVerifiedAt  DateTime                @map("last_verified_at") @db.Date
  /// Foreign key to user added in B3.
  verifiedBy      String?                 @map("verified_by") @db.Uuid
  active          Boolean                 @default(true)
  deletedAt       DateTime?               @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?                 @map("deleted_by") @db.Uuid

  payam Payam @relation(fields: [payamId, stateId], references: [id, stateId], map: "directory_entry_payam_state_consistent_fkey")
  state State @relation(fields: [stateId], references: [id], map: "directory_entry_state_id_fkey")

  verifier User? @relation("DirectoryEntryVerifiedBy", fields: [verifiedBy], references: [id], map: "directory_entry_verified_by_fkey")
  deleter  User? @relation("DirectoryEntryDeletedBy", fields: [deletedBy], references: [id], map: "directory_entry_deleted_by_fkey")
  @@index([entryType, payamId, active], map: "directory_entry_lookup_idx")
  @@index([stateId], map: "directory_entry_state_id_idx")
  @@map("directory_entry")
}

/// Deliverable (m): a repository, not a course system. The file lives in
/// Supabase Storage; this row is its catalogue card.
model LearningResource {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  topic       LearningTopic
  crop        Crop?
  language    Language
  format      ResourceFormat
  storagePath String         @map("storage_path")
  /// Shown next to every download, so an officer on a metered phone can decide.
  byteSize    Int            @map("byte_size")
  description String?
  /// New rows start unpublished; officers see published rows only.
  published   Boolean        @default(false)
  /// Foreign key to user added in B3.
  uploadedBy  String?        @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?        @map("deleted_by") @db.Uuid

  // Both indexes on this table are partial (deleted_at IS NULL) and the unique
  // on storage_path is too. Prisma cannot express partial indexes, so they live
  // in migration 6 only, as the _active indexes on the B2 tables do.
  uploader User? @relation("LearningResourceUploadedBy", fields: [uploadedBy], references: [id], map: "learning_resource_uploaded_by_fkey")
  deleter  User? @relation("LearningResourceDeletedBy", fields: [deletedBy], references: [id], map: "learning_resource_deleted_by_fkey")
  @@map("learning_resource")
}
/// Office staff. NO EMAIL COLUMN: email lives in auth.users and nowhere else,
/// so the two cannot drift. auth_user_id is the only link.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId   String    @unique @map("auth_user_id") @db.Uuid
  name         String
  role         UserRole
  /// Null for an admin, required for a supervisor or read_only. The database
  /// enforces the pair, so a null scope can never mean "everything".
  scopeStateId String?   @map("scope_state_id")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid

  scopeState State? @relation(fields: [scopeStateId], references: [id])
  verificationDecisions VerificationEvent[]
  directoryEntriesVerified DirectoryEntry[] @relation("DirectoryEntryVerifiedBy")
  directoryEntriesDeleted  DirectoryEntry[] @relation("DirectoryEntryDeletedBy")
  learningResourcesUploaded LearningResource[] @relation("LearningResourceUploadedBy")
  learningResourcesDeleted  LearningResource[] @relation("LearningResourceDeletedBy")

  @@index([role], map: "user_role_idx")
  @@index([scopeStateId], map: "user_scope_state_id_idx")
  @@map("user")
}

enum UserRole {
  admin
  supervisor
  read_only

  @@map("user_role")
}

/// Extension officers. `phone` is the identity the officer types; the
/// identifier presented to Supabase Auth is DERIVED from it and is not stored
/// here. See docs/DECISIONS.md.
model Officer {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String        @unique @map("auth_user_id") @db.Uuid
  name       String
  /// E.164, exactly as phoneSchema produces it -- never the GoTrue form, which
  /// strips the leading plus.
  phone      String        @unique
  payamId    String        @map("payam_id")
  /// Denormalised, so a scope check is not a join.
  stateId    String        @map("state_id")
  status     OfficerStatus @default(active)
  lastSyncAt DateTime?     @map("last_sync_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedBy  String?       @map("deleted_by") @db.Uuid

  /// The same composite-key trick as payam: an officer's state cannot disagree
  /// with the state of their payam.
  payam Payam @relation(fields: [payamId, stateId], references: [id, stateId], map: "officer_payam_state_consistent_fkey")
  state State @relation(fields: [stateId], references: [id], map: "officer_state_id_fkey")
  farmersRegistered Farmer[]
  resubmissions     VerificationEvent[]

  @@index([payamId], map: "officer_payam_id_idx")
  @@index([stateId], map: "officer_state_id_idx")
  @@map("officer")
}

enum OfficerStatus {
  active
  inactive

  @@map("officer_status")
}

/// The append-only audit log (B4, C-4). Never updated, never deleted: a
/// database trigger raises on both. entity_id is TEXT so a location code fits;
/// actor_id carries NO foreign key so a row survives its actor -- both are
/// deliberate, see docs/DECISIONS.md. Always written through writeAudit in
/// apps/web/lib/api/audit.ts, inside the transaction of the change it records.
model AuditEvent {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String         @map("entity_type")
  entityId   String         @map("entity_id")
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  before     Json?
  after      Json?
  deviceId   String?        @map("device_id")
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "audit_event_entity_idx")
  @@index([actorId, occurredAt(sort: Desc)], map: "audit_event_actor_idx")
  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_event_occurred_idx")
  @@map("audit_event")
}

enum AuditActorType {
  admin
  supervisor
  read_only
  officer
  system

  @@map("audit_actor_type")
}


// -----------------------------------------------------------------------------
// B5 — the farmer record (C-5). Migration 10.
// -----------------------------------------------------------------------------

enum Sex {
  f
  m

  @@map("sex")
}

enum RegistrationSource {
  officer
  /// In the enum because the data model has it. No route produces it: a value, not a permission.
  self

  @@map("registration_source")
}

enum VerificationStatus {
  pending
  verified
  rejected
  /// B6: a state, with merged_into as the pointer.
  merged

  @@map("verification_status")
}

/// One row per county; the row lock on the upsert is what makes farmer numbers unique (C-5.4).
model FarmerNumberCounter {
  countyId  String @id @map("county_id")
  nextValue Int    @default(1) @map("next_value")

  county County @relation(fields: [countyId], references: [id])

  @@map("farmer_number_counter")
}

model Farmer {
  /// Client-generated (C-5.12). No default.
  id                 String             @id @db.Uuid
  /// Stored at insert, never re-derived (C-5.4).
  farmerNumber       String             @unique(map: "farmer_farmer_number_key") @map("farmer_number")
  givenName          String             @map("given_name")
  familyName         String             @map("family_name")
  sex                Sex
  yearOfBirth        Int                @map("year_of_birth")
  phone              String
  nationalId         String?            @map("national_id")
  payamId            String             @map("payam_id")
  countyId           String             @map("county_id")
  stateId            String             @map("state_id")
  registeredBy       String?            @map("registered_by") @db.Uuid
  registrationSource RegistrationSource @default(officer) @map("registration_source")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  mergedInto         String?            @map("merged_into") @db.Uuid
  consentId          String             @map("consent_id") @db.Uuid
  duplicateFlag      Boolean            @default(false) @map("duplicate_flag")
  duplicateMatches   String[]           @default([]) @map("duplicate_matches") @db.Uuid
  /// The escalation clock (C-6.7): set at registration, reset on resubmission, otherwise immutable (trigger).
  pendingSince       DateTime           @default(now()) @map("pending_since") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?            @map("deleted_by") @db.Uuid

  payam        Payam    @relation(fields: [payamId, stateId], references: [id, stateId], map: "farmer_payam_state_consistent_fkey")
  county       County   @relation(fields: [countyId], references: [id], map: "farmer_county_id_fkey")
  state        State    @relation(fields: [stateId], references: [id], map: "farmer_state_id_fkey")
  registrar    Officer? @relation(fields: [registeredBy], references: [id], map: "farmer_registered_by_fkey")
  mergedTarget Farmer?  @relation("FarmerMerge", fields: [mergedInto], references: [id], map: "farmer_merged_into_fkey")
  mergedFrom   Farmer[] @relation("FarmerMerge")
  /// The current consent. Deferred foreign key: both rows commit together (C-5.3).
  consent      Consent  @relation("CurrentConsent", fields: [consentId], references: [id], map: "farmer_consent_id_fkey")
  consents     Consent[] @relation("FarmerConsents")
  verificationEvents VerificationEvent[] @relation("FarmerVerificationEvents")
  mergeTargetOf      VerificationEvent[] @relation("MergeTargetEvents")

  @@index([payamId, verificationStatus, deletedAt], map: "farmer_payam_status_idx")
  @@index([countyId], map: "farmer_county_id_idx")
  @@map("farmer")
}

/// A record of an event. Never soft-deleted, never removed (data-model-extension §1.3).
model Consent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerId    String    @map("farmer_id") @db.Uuid
  textVersion String    @map("text_version")
  language    Language
  granted     Boolean
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  farmer    Farmer   @relation("FarmerConsents", fields: [farmerId], references: [id], map: "consent_farmer_id_fkey")
  currentOf Farmer[] @relation("CurrentConsent")

  @@index([farmerId], map: "consent_farmer_id_idx")
  @@map("consent")
}

// -----------------------------------------------------------------------------
// B6 — verification (C-6). Migration 11.
// -----------------------------------------------------------------------------

enum VerificationDecision {
  verified
  rejected
  merged
  resubmitted

  @@map("verification_decision")
}

/// A record of an event. Never soft-deleted, never removed (data-model-extension §1.3).
model VerificationEvent {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerId      String               @map("farmer_id") @db.Uuid
  /// Staff user for verified/rejected/merged; null for resubmitted.
  reviewerId    String?              @map("reviewer_id") @db.Uuid
  /// The registering officer, for resubmitted only.
  officerId     String?              @map("officer_id") @db.Uuid
  decision      VerificationDecision
  mergeTargetId String?              @map("merge_target_id") @db.Uuid
  /// Fixed key from REJECTION_REASONS; CHECK generated from the same list.
  reasonCode    String?              @map("reason_code")
  /// Free text about a named person. Data, not a message (C-6.3).
  note          String?
  daysWaiting   Int                  @map("days_waiting")
  decidedAt     DateTime             @default(now()) @map("decided_at") @db.Timestamptz(6)

  farmer      Farmer   @relation("FarmerVerificationEvents", fields: [farmerId], references: [id], map: "verification_event_farmer_id_fkey")
  reviewer    User?    @relation(fields: [reviewerId], references: [id], map: "verification_event_reviewer_id_fkey")
  officer     Officer? @relation(fields: [officerId], references: [id], map: "verification_event_officer_id_fkey")
  mergeTarget Farmer?  @relation("MergeTargetEvents", fields: [mergeTargetId], references: [id], map: "verification_event_merge_target_id_fkey")

  @@index([farmerId, decidedAt(sort: Desc)], map: "verification_event_farmer_idx")
  @@index([reviewerId, decidedAt(sort: Desc)], map: "verification_event_reviewer_idx")
  @@map("verification_event")
}
