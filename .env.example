# Environment variables for the Agriculture ERP monorepo.
#
# This file lists variable NAMES only. Real values never enter this
# repository -- not here, not in code, not in a commit. Copy this file to
# .env.local for local work, and keep real values in the deployment
# platform's secret store.
#
# WHERE .env.local MUST LIVE. Next.js reads env files from the app directory,
# not the repository root: for the web portal that is apps/web/.env.local.
# Keep one copy at the root for the test suite and scripts, and symlink it:
#   ln -s ../../.env.local apps/web/.env.local
# A root-only .env.local leaves the portal with no Supabase variables, and
# every portal page then answers 503 by design (apps/web/middleware.ts).
#
# .env and .env.local are git-ignored at any depth.

# Pooled connection, port 6543, with pgbouncer=true and connection_limit=1.
# ALWAYS with connect_timeout=30. Prisma's default is 5 seconds, and the
# Supabase poolers' TLS-plus-auth handshake takes 1 to 9 seconds on a slow day:
# without this, connections fail as "Can't reach database server" at exactly
# 5.0 s while the pooler is perfectly healthy (found 2026-09-05, B5).
# Query string, exactly: pgbouncer=true&connection_limit=1&connect_timeout=30&schema=public
# (No example URL is written here on purpose: a credential-shaped placeholder trips the secret scan, which has no allowlist.)
# Used by the application at runtime.
DATABASE_URL=

# Session-pooler connection, port 5432 (the direct host is IPv6-only). Used by
# migrations and introspection, which need a session. Same connect_timeout=30,
# same reason.
# Query string, exactly: connect_timeout=30
DIRECT_URL=

# ---------------------------------------------------------------------------
# Supabase Auth (identity only; never authorization -- CLAUDE.md section 3)
# ---------------------------------------------------------------------------

# The project URL, https://<project-ref>.supabase.co. Public.
NEXT_PUBLIC_SUPABASE_URL=

# The anon (publishable) key. Public by design: it reaches the browser so the
# login page can sign in, and it can do nothing a route does not permit.
# Both of these are required for EVERY authenticated request -- lib/api/require-role.ts
# refuses to run without them.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key. Bypasses row-level security. Read in exactly one file,
# lib/supabase/admin.ts, and a test enforces that. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Data mode for the web portal
# ---------------------------------------------------------------------------

# The marketplace and the farmer web flow are public (owner's decision,
# 2026-09-15). Set to 0 to close both behind the staff session and send / to
# sign-in; unset or anything else keeps them open.
NEXT_PUBLIC_MARKET_OPEN=

# Buyer contact requests (deliverable (g)) go to the routes in
# docs/api/contact-request-contract.md when this is 1; otherwise a browser-local
# preview store, so the buyer → officer → farmer path can be walked.
NEXT_PUBLIC_USE_LIVE_CONTACT=

# The farmer home's weather tile reads GET /api/weather (C-16, #78 contract) when
# this is 1; otherwise one placeholder county row, labelled as such.
NEXT_PUBLIC_USE_LIVE_WEATHER=

# Directories (agro-dealer, input supplier, financial services) and the learning
# library read the P1 routes (#28) instead of the fixtures.
NEXT_PUBLIC_USE_LIVE_DIRECTORIES=
NEXT_PUBLIC_USE_LIVE_LIBRARY=

# Each switches a group of screens from fixture data to the live routes.
# Set to 1 to go live; anything else (including unset) is fixtures. Unset on a
# fresh deployment means the public site is showing invented demo data.
NEXT_PUBLIC_USE_LIVE_FARMERS=
NEXT_PUBLIC_USE_LIVE_VERIFICATION=
NEXT_PUBLIC_USE_LIVE_ADMIN=
# Extension visits (deliverable (d), C-8): the visit log and record-a-visit.
NEXT_PUBLIC_USE_LIVE_VISITS=
# Farm boundaries and crops on the farmer dossier (deliverable (c), C-7).
NEXT_PUBLIC_USE_LIVE_FARMS=
# Reach and coverage figures and the export log (deliverables (p)(q), C-10).
NEXT_PUBLIC_USE_LIVE_REPORTS=

# ---------------------------------------------------------------------------
# Error reporting (Sentry)
# ---------------------------------------------------------------------------

# Where error reports are sent. A Sentry DSN is a write-only ingest key: it
# can create events and can read nothing. It must reach the browser for
# client-side errors to be reported at all, which is why it is NEXT_PUBLIC_.
# Leave it empty to switch error reporting off entirely -- local machines and
# CI report nothing.
# Set in Vercel, not on a laptop. Local machines leave it empty; a DSN here sends local
# stack paths (with the OS username) to Sentry. To re-verify: add, run pnpm sentry:verify, remove.
NEXT_PUBLIC_SENTRY_DSN=

# Which deployment an error came from: staging or production. Falls back to
# VERCEL_ENV, then to "development".
# Set explicitly in Vercel: 'staging' for preview deployments, 'production' for production.
# Never rely on the VERCEL_ENV fallback -- Vercel says 'preview', which is not a name we use.
SENTRY_ENVIRONMENT=

# Which build an error came from. Falls back to VERCEL_GIT_COMMIT_SHA, then to
# "unknown".
SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Operational scripts
# ---------------------------------------------------------------------------

# Overrides the path to the locations CSV that scripts/locations-*.mjs read.
# Optional and the only optional name in this file: without it the scripts use
# the committed list, which is the normal case. Set it to load CORWADO's list
# when that arrives, so the real file is never copied over the committed one.
LOCATIONS_CSV=

# ---------------------------------------------------------------------------
# SMS (Bird) -- CLAUDE.md section 3. Deliverable (n) is phase 6; only
# scripts/bird-sms-verify.mjs reads these today.
# ---------------------------------------------------------------------------

# Bearer token for the Bird API. A secret: it can send messages that CORWADO
# pays for. NEVER prefixed NEXT_PUBLIC_ -- that would ship it to every browser.
BIRD_API_KEY=

# The workspace's regional host, with no trailing slash, e.g.
# https://us1.platform.bird.com -- the region is part of the URL and differs
# per workspace, so it is configuration and not a constant.
BIRD_API_BASE_URL=

# The alphanumeric sender recipients see: 3 to 11 letters, digits, spaces,
# dashes or underscores, at least one letter. Bird lists an alphanumeric sender
# as the ONLY sender type for South Sudan (+211) -- no local number and no
# shortcode -- and requires no registration for it. A purchased number cannot
# carry +211 traffic.
BIRD_SMS_SENDER_ID=

# ---------------------------------------------------------------------------
# Weather (OpenWeather) -- CLAUDE.md section 3, C-16
# ---------------------------------------------------------------------------

# Read ONLY by the fetch job (scripts/weather-fetch.mjs) and the throwaway
# verify. Never NEXT_PUBLIC_ and never read by a route: no route fetches
# weather, so the browser has no reason to hold the key. A fresh key returns
# 401 for up to two hours after creation; that is activation, not a wrong key.
OPENWEATHER_API_KEY=
# ── Email (administrator communications) ────────────────────────────────────
# Resend is the decided provider (CLAUDE.md section 3). Both are SERVER-SIDE
# ONLY: neither is NEXT_PUBLIC_, because that prefix would ship the value to
# every browser. The route refuses to send and answers 503
# `email_not_configured` when either is missing — it never pretends a message
# was delivered.
#
# The account and the sending domain are CORWADO's, never ours, and the domain
# needs its own DNS records before Resend will accept mail from it.
RESEND_API_KEY=
# The From address. Must be on a domain verified in the Resend account.
EMAIL_FROM=
