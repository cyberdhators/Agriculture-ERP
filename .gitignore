# dependencies
node_modules/

# next.js
.next/
out/

# build output
dist/
build/
*.tsbuildinfo

# environment
#
# Broad on purpose. The earlier patterns matched .env.local but not
# .env.local.bak, .env.local.old or .env.backup -- so a backup of a credential
# file taken during ordinary work was committable. It happened during B2 and
# was caught by inspection rather than by the rules. Ignore every .env variant
# and let .env.example back in explicitly.
.env
.env.*
!.env.example

# test output
coverage/
# ...but the farm coverage screen is product, not test output.
!apps/web/app/(portal)/coverage/
!apps/web/components/coverage/

# os
.DS_Store
.local/
